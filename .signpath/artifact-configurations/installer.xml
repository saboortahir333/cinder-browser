<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": a zip containing CinderBrowser_Setup.exe.
     The uninstaller embedded by Inno Setup is signed during the Inno build only when
     a local signing tool is configured; the outer installer is signed here. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="CinderBrowser_Setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
